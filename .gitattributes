# Normalize line endings: Godot and the CI tools expect LF.
* text=auto eol=lf

# Binary assets (never diff or normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.res binary
*.scn binary
*.zip binary
*.tpz binary
